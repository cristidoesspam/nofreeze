{
	"schemaVersion": 1,
	"id": "nofreeze",
	"version": "${version}",
	"name": "No Freeze",
	"description": "Adds a game rule that stops water from freezing, ever. In the mod settings you can remove the game rule and make it permanent instead.",
	"authors": [
		"cristidoesspam"
	],
	"license": "MIT",
	"icon": "assets/nofreeze/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.nofreeze.NoFreeze"
		],
		"client": [
			"dev.nofreeze.client.NoFreezeClient"
		],
		"modmenu": [
			"dev.nofreeze.client.NoFreezeModMenu"
		]
	},
	"mixins": [
		"nofreeze.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
